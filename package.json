{
  "name": "cancan",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "pnpm --filter @cancan/desktop dev",
    "desktop:dev": "pnpm --filter @cancan/desktop desktop:dev",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test:unit": "vitest run --exclude 'spikes/**'",
    "test:synthetic-core": "vitest run packages/core packages/parsers packages/db",
    "check:rust": "pnpm --filter @cancan/desktop check:rust",
    "test:rust": "pnpm --filter @cancan/desktop test:rust",
    "build:web": "pnpm --filter @cancan/desktop build:web",
    "build:desktop": "pnpm --filter @cancan/desktop build:desktop",
    "check:file-size": "node scripts/check-source-file-size.mjs",
    "verify:fast": "pnpm check:file-size && pnpm typecheck && pnpm test:unit && pnpm build:web",
    "verify:native": "pnpm --filter @cancan/desktop verify:native",
    "verify": "pnpm check:file-size && pnpm typecheck && pnpm test:unit && pnpm --filter @cancan/desktop verify"
  },
  "devDependencies": {
    "happy-dom": "20.10.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
