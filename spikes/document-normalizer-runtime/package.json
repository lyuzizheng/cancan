{
  "name": "cancan-document-normalizer-runtime-spike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "spike:check": "pnpm build:sidecar && cd src-tauri && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:tauri": "pnpm build:sidecar && tauri build --debug --bundles app -- --locked",
    "evidence": "node scripts/run-evidence.mjs",
    "spike:verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@cancan/parsers": "link:../../packages/parsers",
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "ai": "6.0.224",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.12.0"
}
