{
  "name": "@cancan/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "pnpm build:sidecar && tauri dev",
    "typecheck": "tsc --project tsconfig.json",
    "check:rust": "pnpm build:sidecar && pnpm check:rust:prepared",
    "check:rust:prepared": "cd src-tauri && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "test:rust": "pnpm build:sidecar && pnpm test:rust:prepared",
    "test:rust:prepared": "cd src-tauri && cargo test --locked",
    "build:web": "vite build",
    "build:sidecar": "pnpm --filter @cancan/ai build:sidecar",
    "build:desktop": "pnpm build:sidecar && pnpm build:desktop:prepared",
    "build:desktop:prepared": "tauri build --debug --no-bundle -- --locked",
    "verify:native": "pnpm build:sidecar && pnpm test:rust:prepared && pnpm check:rust:prepared && pnpm build:desktop:prepared",
    "verify": "pnpm build:sidecar && pnpm check:rust:prepared && pnpm build:desktop:prepared"
  },
  "dependencies": {
    "@cancan/ui": "workspace:*",
    "@tauri-apps/api": "2.11.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
