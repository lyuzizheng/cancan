{
  "name": "@cancan/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CanCan static public website (Cloudflare Pages), pre-rendered at build",
  "scripts": {
    "dev": "pnpm build && vite preview --host 127.0.0.1 --port 1443",
    "typecheck": "tsc --project tsconfig.json",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "check": "node scripts/check.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1443"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@fontsource-variable/geologica": "5.2.8",
    "@fontsource-variable/martian-mono": "5.2.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
